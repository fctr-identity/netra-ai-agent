# Local, single commercial Entra tenant. Application credentials, not delegated login.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Comma-separated selected user properties. Examples:
# employeeType,onPremisesExtensionAttributes.extensionAttribute1,extension_APPID_costCenter
ENTRA_USER_CUSTOM_ATTRIBUTES=

# Choose the existing supported model provider. Configure its reasoning/coding models.
AI_PROVIDER=openai_compatible
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_TOKEN=
OPENAI_COMPATIBLE_REASONING_MODEL=
OPENAI_COMPATIBLE_CODING_MODEL=
# Alternative: AI_PROVIDER=azure_openai
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_REASONING_MODEL=
# AZURE_OPENAI_CODING_MODEL=
# Alternative: AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_REASONING_MODEL=
# OPENAI_CODING_MODEL=

SYNC_MFA_REGISTRATION=true
SYNC_DIRECTORY_ROLES=false
SYNC_CONDITIONAL_ACCESS=false
SYNC_DEVICES=false
GRAPH_CONCURRENT_LIMIT=4
GRAPH_MAX_PAGES=1000
GRAPH_TIMEOUT_SECONDS=120
DB_FILENAME=netra.db

# Blank creates a temporary local JWT key; restarting signs users out.
# To retain sessions across restarts, supply a random value of at least 32 bytes.
JWT_SECRET_KEY=
COOKIE_SECURE=false
LOG_LEVEL=INFO
QUERY_PROCEDURES_ENABLED=false

# Teams uses a separate Bot Service identity; directory reads use ENTRA_* above.
TEAMS_ENABLE=false
# TEAMS_TENANT_ID=
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_ALLOWED_GROUP_IDS=
